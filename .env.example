# Domínio canônico do portal (sem barra no final).
# Usado em sitemap, canonical, Open Graph e schema.org.
VITE_SITE_URL=https://seu-dominio.com.br

# Google Search Console — meta tag de verificação
# Em Search Console → Configurações → Verificação de propriedade → Tag HTML
# Copie só o valor do atributo content="..."
VITE_GOOGLE_SITE_VERIFICATION=

# Google Tag Manager (recomendado) — ex.: GTM-XXXXXXX
VITE_GTM_ID=

# Ou GA4 direto (se não usar GTM) — ex.: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=
